# Clave secreta de Django — reemplazar con una cadena aleatoria larga y única en producción
SECRET_KEY=django-insecure-reemplazar-con-clave-secreta-aleatoria

# Modo depuración — True en desarrollo, False en producción
DEBUG=True

# URL de conexión a la base de datos
# SQLite para desarrollo local:
# DATABASE_URL=sqlite:///./db.sqlite3
# PostgreSQL / NeonDB en producción:
# DATABASE_URL=postgres://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./db.sqlite3
